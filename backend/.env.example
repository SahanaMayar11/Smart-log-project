# Smart-Log Environment Variables & Email Configuration Template
# Copy this file to '.env' and fill in your actual credentials.
# NEVER commit real credentials or App Passwords to version control.

# SMTP Email Alert Credentials (Support Gmail, Outlook, Custom SMTP)
SMARTLOG_SMTP_HOST=smtp.gmail.com
SMARTLOG_SMTP_PORT=587
SMARTLOG_SMTP_USERNAME=your_email@gmail.com
SMARTLOG_SMTP_PASSWORD=your_gmail_app_password
SMARTLOG_ALERT_EMAIL=security_admin@yourcompany.com

# Isolation Forest selection: leave as "active" for normal operation.
# Set to "hdfs" only for a temporary process-level HDFS model test.
# This never overwrites or renames models/isolation_forest_model.pkl.
SMARTLOG_IF_MODEL=active
